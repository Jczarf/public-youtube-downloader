{
  "name": "mediaflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:web": "rm -rf web/static/chunks && esbuild web/frontend.js --bundle --format=esm --splitting --platform=browser --target=es2022 --minify --outdir=web/static --entry-names=app --chunk-names=chunks/[name]-[hash]"
  },
  "dependencies": {
    "mediabunny": "1.56.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
